# Agent Settings
NANOBOT__AGENTS__DEFAULTS__MODEL=deepseek-chat
NANOBOT__AGENTS__DEFAULTS__MAX_ITERATIONS=20

# Providers (Choose your provider)
DEEPSEEK_API_KEY=your_deepseek_key_here
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Provider Base URLs (Optional)
NANOBOT__PROVIDERS__DEEPSEEK__API_BASE=https://api.deepseek.com
# NANOBOT__PROVIDERS__OPENAI__API_BASE=https://api.openai.com/v1

# Channel Settings
NANOBOT__CHANNELS__WECOM__ENABLED=false
NANOBOT__CHANNELS__WECOM__CORPID=
NANOBOT__CHANNELS__WECOM__CORPSECRET=
NANOBOT__CHANNELS__WECOM__AGENTID=
# API 接收设置（必须与企业微信后台一致）
NANOBOT__CHANNELS__WECOM__TOKEN=随机生成的Token
NANOBOT__CHANNELS__WECOM__ENCODING_AES_KEY=随机生成的Key
NANOBOT__CHANNELS__WECOM__PORT=3000
